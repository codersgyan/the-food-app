# The server's settings. Copy this file to .env for your laptop:
#
#     cp .env.example .env
#
# The Makefile loads .env for make run, make migrate and make seed. On a
# server, the settings go in /etc/food-api.env instead, with new secrets and
# a POSTGRES_PASSWORD (see deploy/README.md).
#
# Write each line as KEY=value, with no quotes and no spaces around the =.

# --- Secrets. The server won't start without them. ---

# Signs login tokens. Anyone who knows it can log in as any user.
# On a server, use a long random value: openssl rand -hex 32
JWT_SECRET=dev-only-jwt-secret

# The payment provider signs its webhooks with this. The Bruno collection
# signs its test webhook with the same value, so keep them in sync on your laptop.
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret

# --- Everything else has a default. Uncomment a line to change it. ---

# Where the server listens.
# ADDR=:8080

# DATABASE_URL=postgres://food:food@localhost:5440/food?sslmode=disable

# How far a restaurant can be and still deliver, in km.
# NEAR_RADIUS_KM=7

# How long the fake OTP service takes to answer.
# FAKEOTP_DELAY=200ms-500ms

# How long the customer takes to approve a payment, and where the fake
# payment provider sends its webhook.
# FAKEPAY_DELAY=1s-2s
# FAKEPAY_WEBHOOK_URL=http://localhost:8080/payments/webhook

# The share of payments that fail, and of webhooks sent twice, from 0 to 1.
# FAKEPAY_FAIL_RATE=0
# FAKEPAY_DUPLICATE_RATE=0
